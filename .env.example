# Порт, на котором игра будет доступна снаружи.
PORT=8080

# Ключ Anthropic API. Нужен ТОЛЬКО для режима оппонента «Нейросеть».
# Без него игра полностью работоспособна: доступны четыре программных уровня сложности.
# Ключ читается сервером и в браузер не передаётся.
ANTHROPIC_API_KEY=

# Модель и глубина рассуждений для режима нейросети.
WOTG_LLM_MODEL=claude-opus-5
WOTG_LLM_EFFORT=medium

# Ограничение частоты обращений к модели (запросов в минуту) — защита от
# неожиданно большого счёта, если сервер открыт наружу.
WOTG_LLM_RPM=60

LOG_LEVEL=info
